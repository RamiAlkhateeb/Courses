# Optional. Leave both empty (or don't create .env.local at all) and the app is guest-only: no accounts, no network.
# Copy this file to .env.local and fill in your Supabase project's values (Project Settings -> API).
# Only the project URL and the anon / publishable key belong here. Never put a service_role key in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
